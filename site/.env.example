# The marketing site's own environment.
#
# Only one thing here is required, and only for the enquiry form: somewhere to
# send mail from. Without it the form refuses and points the visitor at
# WhatsApp rather than pretending the enquiry arrived.
#
# Where enquiries go is NOT configured here. Both addresses —
# operations@wd-logistics.co.zw and admin@wd-logistics.co.zw — are hardcoded in
# src/lib/mail.ts, so a lead cannot be lost to a variable somebody forgot to
# set on a new deploy.

# SMTP, for sending the enquiry form. Same mailbox the system uses is fine.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
# "true" only for port 465, which is implicit TLS. 587 upgrades with STARTTLS.
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL="your-email@gmail.com"
SMTP_FROM_NAME="WD Logistics website"
