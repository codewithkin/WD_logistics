# WD Logistics — root environment file for `docker-compose.yml`
#
# Copy this to `.env` in the repo root (same directory as docker-compose.yml)
# and fill in real values — docker-compose reads `.env` here automatically
# for ${VAR} substitution. This is separate from app/.env.example and
# agent/.env.example, which are for running each service standalone
# (`bun run dev`, or a standalone deploy of just one service) without Docker.
#
# Required values (compose will refuse to start without these):
#   POSTGRES_PASSWORD, BETTER_AUTH_SECRET, AGENT_API_KEY, OPENROUTER_API_KEY

# The organisation this bot belongs to. Needed only for delivery receipts:
# an ack arrives from WhatsApp rather than from a request, so there is no
# per-call organisation to read it from. Find it in the app's database
# (`select id from organization`), or leave blank — the app looks receipts up
# by WhatsApp's own message id, which is globally unique.
AGENT_ORGANIZATION_ID=""
#
# See CLAUDE.md's "Auth & authorization model" and "Two-service split" for
# what each integration point actually does.

# =============================================================================
# HOST PORTS
# =============================================================================
# Which ports the containers are published on. The app listens on 3000 and
# the agent on 3001 *inside* their containers regardless of these values.
APP_PORT=3000
AGENT_PORT=3001

# =============================================================================
# PUBLIC URLS
# =============================================================================
# Real, internet-reachable URLs for this deployment (domain, or VPS IP + the
# ports above). Used for OAuth/session callbacks, client-side fetches, and —
# importantly — CORS: the agent only accepts direct browser requests whose
# Origin matches NEXT_PUBLIC_APP_URL/WEB_APP_URL below. Put a reverse proxy
# (Caddy/Nginx) with real domains + TLS in front of both ports for production;
# until then these can point at http://<vps-ip>:3000 / :3001.
NEXT_PUBLIC_APP_URL="https://logistics.example.com"
BETTER_AUTH_URL="https://logistics.example.com"
NEXT_PUBLIC_AGENT_URL="https://agent.logistics.example.com"
# Server-side URL the app uses to call the agent (usually identical to
# NEXT_PUBLIC_AGENT_URL — see docker-compose.yml's networking note).
AGENT_URL="https://agent.logistics.example.com"
# Server-side URL the agent uses to call the app back (usually identical to
# NEXT_PUBLIC_APP_URL) — also doubles as the agent's CORS allow-list origin.
WEB_APP_URL="https://logistics.example.com"

# =============================================================================
# DATABASE (Postgres, run as the `postgres` service in docker-compose.yml)
# =============================================================================
# POSTGRES_* provision the bundled Postgres container; DATABASE_URL is what
# Prisma actually connects with (`postgres` = the compose service hostname,
# on the internal Docker network — not a typo, not the app's own hostname).
# Point DATABASE_URL at an external managed Postgres instead if you don't
# want to self-host the database on this VPS; in that case POSTGRES_* here
# are unused and the `postgres` service in docker-compose.yml can be removed.
POSTGRES_USER="wdlogistics"
POSTGRES_PASSWORD="change-me-to-a-strong-password"
POSTGRES_DB="wdlogistics"
DATABASE_URL="postgresql://wdlogistics:change-me-to-a-strong-password@postgres:5432/wdlogistics"
# Optional: Prisma Accelerate proxy URL, if you use it instead of/alongside
# a direct connection (see app/src/lib/prisma.ts). Leave unset otherwise.
ACCELERATE_URL=""

# =============================================================================
# ADMIN BOOTSTRAP (app only — prisma/ensure-admin.mjs)
# =============================================================================
# Runs automatically on every container start (see app/Dockerfile's CMD) to
# guarantee one organization + one admin user exist. It never deletes
# anything and does nothing once an admin already exists, so it's safe on
# every redeploy. Override these to avoid the well-known stock credentials
# in a real production deploy — otherwise it defaults to
# dziruniw@gmail.com / @logisticswd (change the password after first login
# either way).
SEED_ORG_NAME="WD Logistics"
SEED_ORG_SLUG="wd-logistics"
SEED_ADMIN_NAME="Mr Dziruni"
SEED_ADMIN_EMAIL="dziruniw@gmail.com"
SEED_ADMIN_PASSWORD="@logisticswd"

# =============================================================================
# AUTH (better-auth, app only)
# =============================================================================
# Session/token signing secret — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET="your-secret-key-here-min-32-characters-long"

# =============================================================================
# AGENT <-> APP SHARED SECRET
# =============================================================================
# Must be IDENTICAL on both services — authenticates the app's /api/agent/*
# endpoints against the agent, and vice versa. Generate with: openssl rand -hex 32
AGENT_API_KEY="your-shared-agent-api-key-change-this-to-random-string"

MASTRA_LOG_LEVEL="info"

# Web push (VAPID). Generate your OWN pair — never reuse an example:
#   bunx web-push generate-vapid-keys
#
# VAPID_PUBLIC_KEY is read at RUNTIME (see /api/push/public-key), so it does
# not need to be a build arg. NEXT_PUBLIC_VAPID_PUBLIC_KEY is still read as a
# fallback for older deployments, but prefer the runtime one.
#
# Changing the pair invalidates every existing subscription — everyone has to
# press Enable again, and the delivery log will show 401/403 until they do.
VAPID_PUBLIC_KEY="<your public key>"
VAPID_PRIVATE_KEY="<your private key>"
# A real contact address. Apple's push service rejects placeholder subjects,
# which shows up as "push works everywhere except iPhones".
VAPID_SUBJECT="mailto:operations@wd-logistics.co.zw"

ENABLE_WHATSAPP="false"
# Bypasses the live WhatsApp connection for the agent's /test-whatsapp route.
TEST_MODE="false"

# =============================================================================
# EMAIL (SMTP / nodemailer, app only)
# =============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
# "true" for port 465, "false" for STARTTLS (587) or unencrypted.
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL="your-email@gmail.com"
SMTP_FROM_NAME="WD Logistics"

# =============================================================================
# CLOUDFLARE R2 (file uploads, app only — see app/src/lib/r2.ts)
# =============================================================================
# R2 speaks the S3 API, so this reuses @aws-sdk/client-s3 pointed at R2's
# endpoint instead of real AWS. Get these from the Cloudflare dashboard:
# R2 > Manage R2 API Tokens (key pair), R2 > your bucket > Settings (account
# ID + public URL).
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-r2-bucket-name"
# Public base URL for serving uploads — either the bucket's public r2.dev
# URL or a mapped custom domain. Unlike S3+CloudFront, there's no working
# fallback if this is unset.
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxx.r2.dev"

# =============================================================================
# MISC APP FEATURE FLAGS
# =============================================================================
# Bearer-token secret protecting POST /api/cron/invoice-reminders. Leave set
# in production — an empty value silently disables auth on that endpoint.
CRON_SECRET="change-me-to-a-random-string"
# Lets supervisors (not just admins) see the Expenses nav item under
# Operations. See app/src/config/navigation.ts.
SHOW_EXPENSES="false"

# ---- WhatsApp assistant ----
# The assistant answers messages from the contacts an admin has added under
# Settings. It runs on OpenRouter so the model can be changed without a
# deploy. Get a key from https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# Override only if the default model id stops being valid — OpenRouter
# renames models occasionally. The agent logs which id it is using at boot.
ASSISTANT_MODEL="google/gemini-3.5-flash-lite"
# low | medium | high. These are reasoning models and their thinking is
# billed as output; "low" measured 7x cheaper and nearly twice as fast
# with no loss on the checks in agent/scripts/live-assistant-check.ts.
ASSISTANT_REASONING_EFFORT="low"
# Where the model is served from. Defaults to OpenRouter. Point it at a
# company gateway, a proxy, or a stub server when testing the assistant
# without spending tokens.
# ASSISTANT_BASE_URL="https://openrouter.ai/api/v1"
