# Dependencies & build output — reinstalled/rebuilt inside the image
node_modules
.next
out
build

# Prisma client is regenerated during the image build (postinstall runs
# `prisma generate`) — never ship a host-generated copy into the build context
src/generated

# VCS / editor
.git
.gitignore
.vscode
.idea

# Env files — never bake secrets into an image layer
.env
.env.*
!.env.example

# WhatsApp session data — persisted via a volume at runtime, not baked in
.wwebjs_auth
.wwebjs_cache

# Logs / OS noise / misc
*.log
.DS_Store
*.pem
coverage
*.tsbuildinfo
next-env.d.ts
