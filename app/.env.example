# Database (Prisma Postgres / Accelerate URL)
# For local development, run `bunx prisma dev` to start a local Prisma Postgres server
# Or use a remote PostgreSQL database URL
DATABASE_URL="prisma+postgres://localhost:51213/?api_key=your-api-key"
# Optional: Prisma Accelerate proxy URL, used instead of a direct connection
# when set (see src/lib/prisma.ts). Leave unset for a plain DATABASE_URL.
ACCELERATE_URL=""

# Better Auth
BETTER_AUTH_SECRET="your-secret-key-here-min-32-characters-long"
BETTER_AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Agent Integration
AGENT_URL="http://localhost:3001"
NEXT_PUBLIC_AGENT_URL="http://localhost:3001"
# Shared API Key for authentication (MUST match the agent's AGENT_API_KEY)
# Generate a strong random key: openssl rand -hex 32
AGENT_API_KEY="your-shared-agent-api-key-change-this-to-random-string"

# Google Maps API — @react-google-maps/api is installed but this key is not
# currently read anywhere in src/ (no route-selection integration wired up
# yet). Harmless to set now; has no effect until that feature lands.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Cloudflare R2 (for image uploads — see src/lib/r2.ts)
# R2 speaks the S3 API, so this uses the same @aws-sdk/client-s3 package as
# AWS S3 would, just pointed at R2's endpoint. Get these from the Cloudflare
# dashboard: R2 > Manage R2 API Tokens (for the key pair) and R2 > your
# bucket > Settings (for the account ID and public URL).
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-r2-bucket-name"
# Public base URL for serving uploaded files — either the bucket's public
# r2.dev URL (enable under bucket Settings > Public Access) or a custom
# domain you've mapped to it. Unlike S3+CloudFront, there is NO working
# fallback if this is left unset — the bucket isn't reachable over plain
# HTTP at all until one of these is configured.
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxx.r2.dev"

# SMTP (for nodemailer sendEmail helper)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
# "true" for port 465, "false" for STARTTLS (587) or unencrypted.
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL="your-email@gmail.com"
SMTP_FROM_NAME="WD Logistics"

# WhatsApp Notifications
# Admin WhatsApp number to receive notifications for key actions
# Format: +263XXXXXXXXX (include country code)
ADMIN_WHATSAPP_NUMBER="+263XXXXXXXXX"

# Bearer-token secret protecting POST /api/cron/invoice-reminders.
# An empty value silently disables auth on that endpoint — always set this
# in production. Generate with: openssl rand -hex 32
CRON_SECRET="change-me-to-a-random-string"

# Lets supervisors (not just admins) see the Expenses nav item under
# Operations. See src/config/navigation.ts.
SHOW_EXPENSES="false"
