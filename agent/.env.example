# Environment variables for the AI Agent

# Server
PORT=3001

# Web App API Configuration
# The agent communicates with the web app via API endpoints instead of direct database access
WEB_APP_URL="http://localhost:3000"

# Shared API Key for authentication (MUST match the web app's AGENT_API_KEY)
# Generate a strong random key: openssl rand -hex 32
AGENT_API_KEY="your-shared-agent-api-key-change-this-to-random-string"

# OpenAI API Key (for Mastra.ai)
OPENAI_API_KEY="your-openai-api-key"

# Mastra.ai Configuration
MASTRA_LOG_LEVEL="info"

# WhatsApp Configuration
# Set to "true" or "1" to enable WhatsApp integration
# WhatsApp requires Chrome/Chromium and may not work in all environments
# Recommended: Enable only in development or properly configured production
ENABLE_WHATSAPP="true"

# Test mode - set to "true" to test without live WhatsApp connection
TEST_MODE="false"

# Authorized WhatsApp Numbers (include country code with + prefix, e.g., "+263789859332")
# Admin WhatsApp number (should match app's ADMIN_WHATSAPP_NUMBER)
ADMIN_WHATSAPP_NUMBER="+263XXXXXXXXX"

# Developer numbers for testing and support
WHATSAPP_DEVELOPER_NUMBER_ONE="+263XXXXXXXXX"
WHATSAPP_DEVELOPER_NUMBER_TWO="+263XXXXXXXXX"
